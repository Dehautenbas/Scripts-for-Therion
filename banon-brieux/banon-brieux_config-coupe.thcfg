encoding  utf-8
input ../../config2.thcfg
input ../../../layouts/config3.thcfg
source banon-brieux_tot.th


################################## Selection de la map à exporter #################################
select MC_banon-brieux@banon-brieux-tot      #uncomment ONLY one


#export map \
     -projection extended \
     -layout coupe \
     -output exports/banon-brieux_coupe.pdf \

### Stations             # l'ordre des layouts est importants !
#export map \
     -projection extended \
     -layout coupe \
     -layout centerline \
     -output exports/banon-brieux_coupe-travail.pdf \

### Debug
#export map \
     -projection extended \
     -layout coupe   \
     -layout-debug all \
     -output exports/banon-brieux_DEBUG_coupe.pdf
