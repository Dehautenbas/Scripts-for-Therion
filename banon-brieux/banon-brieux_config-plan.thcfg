encoding  utf-8
input ../../config2.thcfg
input ../../../layouts/config3.thcfg
source banon-brieux_tot.th

################################## Selection de la map à exporter #################################
select MP_banon-brieux@banon-brieux-tot       #uncomment ONLY one




### plan
export map \
     -projection plan \
     -layout plan \
     -output exports/banon-brieux_plan.pdf \

### stations      ## l'ordre des layouts est importants !
export map \
     -projection plan \
     -layout plan \
     -layout centerline \
     -output exports/banon-brieux_plan-travail.pdf \

### debug
#export map \
     -projection plan \
     -layout plan   \
     -layout-debug all \
     -output exports/banon-brieux_DEBUG_plan.pdf

### 3d
    #export model \
     -format loch \
     -o exports/banon-brieux-3d.lox \
     #-wall-source maps
     
### Exporte uniquement les murs
#export map \
     -projection plan \
     -layout walls   \
     -output exports/banon-brieux_walls.pdf \
     #-layout hide_point \
     #-layout-debug station-names \
     #-layout debug \
     #-layout centreline \


######################### ATLAS ########################
#export atlas \
     -projection plan \
     -layout plan   \
     -output exports/banon-brieux_Atlas.pdf 




######################## KML #######################
#export map \
     -projection plan \
     -output exports/banon-brieux.kml  ###-> Pour murs

#export model \
     -output exports/banon-brieux-shots.kml  ###-> pour fil de fer sans station avec splays shots


######################## LISTES ########################
