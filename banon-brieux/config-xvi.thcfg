###Pour morphing du XVI


#1) .TH
source datas/banon-brieux.th

#2) .TH2   ##SEULEMNT SI MORPHING
#source datas/XVI-P_CAVENAME.th2

#3) EXPORT
export map -proj plan -o datas/banon-brieux_P.xvi -layout-sketches on
export map -proj extended -o datas/banon-brieux_C.xvi -layout-sketches on
